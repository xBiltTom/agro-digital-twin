# ==========================================
# AP-3 Digital Twin Platform - Configuración
# ==========================================

APP_ENV=development
# Required outside development/test. Replace with a cryptographically random value.
SECRET_KEY=CHANGE_ME
# Opt-in only: creates known local demo credentials and legacy demo fixtures.
ENABLE_DEMO_SEED=true
ENABLE_MVP_BOOTSTRAP=true

# Use the existing system PostgreSQL role/database through the standard socket.
DATABASE_URL=postgresql+asyncpg://digitaltwin@/digitaltwin?host=/run/postgresql&port=5432

# For another PostgreSQL instance, manage credentials outside this repository.
# Override DATABASE_URL for another PostgreSQL role or authentication method;
# keep credentials outside Git.

# Optional external capabilities
EXTERNAL_MODELS_DIR=../models/external
SWAT_PLUS_EXECUTABLE=
SWAT_PLUS_PROJECT_DIR=
# Each run is copied here before execution; the project above is never modified.
SWAT_PLUS_WORKING_DIRECTORY=../data/swat-runs
CMIP6_ARTIFACT_DIR=../data/climate/cmip6

# AI Scientific Copilot (LangChain)
# Proporciona una clave de API de Gemini o OpenAI para activar la generación con LLM en vivo.
# Si se deja vacía, el sistema utiliza el motor experto determinista de forma offline.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash
